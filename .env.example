# Copie para .env.local e preencha. O .env.local fica fora do git.

# ---- Supabase (blog, notícias e ajustes de produto) ----
# Públicas por natureza: o que protege os dados é o RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Publicação de notícias por automação ----
# Token que a automação do Sérgio envia no cabeçalho Authorization.
# É uma senha: quem tiver ele publica notícia no site.
# Gere um novo com:  node -e "console.log('esq_'+require('crypto').randomBytes(24).toString('hex'))"
NOTICIAS_API_TOKEN=

# Chave de serviço do Supabase, usada SÓ pela rota /api/noticias, no servidor.
# Ela IGNORA o RLS: nunca pode ir para o navegador nem para o git.
# Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
